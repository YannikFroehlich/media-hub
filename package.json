{
  "name": "media-hub",
  "version": "0.0.0",
  "description": "Lokales, TV-taugliches Dashboard für Medien, Websites und häufig verwendete Tools.",
  "author": "Yannik Fröhlich",
  "main": "electron/main.mjs",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "serve:prod": "node scripts/windows/server.mjs dist/media-hub/browser 4173",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "electron:start": "electron .",
    "electron:dev": "npm run build && npm run electron:start",
    "electron:pack": "npm run build && electron-builder --win --publish never"
  },
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/cdk": "^22.1.5",
    "@angular/common": "^22.1.5",
    "@angular/compiler": "^22.1.5",
    "@angular/core": "^22.1.5",
    "@angular/forms": "^22.1.5",
    "@angular/platform-browser": "^22.1.5",
    "@angular/router": "^22.1.5",
    "@fontsource-variable/roboto-condensed": "^5.3.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "electron-updater": "^6.8.9",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.5",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.0.1",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
