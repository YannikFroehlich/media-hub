{
  "name": "media-hub",
  "version": "0.0.0",
  "description": "Lokales, TV-taugliches Dashboard für Medien, Websites und häufig verwendete Tools.",
  "author": "Yannik Fröhlich",
  "main": "electron/main.mjs",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "serve:prod": "node scripts/windows/server.mjs dist/media-hub/browser 4173",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "electron:start": "electron .",
    "electron:dev": "npm run build && npm run electron:start",
    "electron:pack": "npm run build && electron-builder --win portable"
  },
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@fontsource-variable/roboto-condensed": "^5.3.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@angular/build": "^21.2.21",
    "@angular/cli": "^21.2.21",
    "@angular/compiler-cli": "^21.2.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
